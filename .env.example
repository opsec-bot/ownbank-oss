# Copy to .env (Docker) or .env.local (local dev). Never commit it.
# Every secret is generated for you on first start and stored in secrets.json next to the database.
# Anything you set here wins over the generated value.

# ---------- Required ----------

# Public address of the app: cookies, OAuth redirects, push links. Use your real https address when it is not on localhost.
APP_URL=http://localhost:3000

# ---------- Optional ----------

# Timezone for dates, quiet hours and digests (IANA name). Default America/Chicago.
APP_TIMEZONE=

# Crypto wallet balances. Free key at https://dashboard.helius.dev (the URL contains the key, keep it secret).
HELIUS_RPC_URL=

# Phone notifications through the free ntfy app. Pick a long random topic. NTFY_URL defaults to https://ntfy.sh.
NTFY_TOPIC=
NTFY_URL=
NTFY_TOKEN=

# Off-site database backups with Litestream, to any S3 compatible bucket (Tigris, R2, B2, S3).
BUCKET_NAME=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Let Claude change data through MCP (recategorize, rules, budgets). Default off: read only.
MCP_WRITE_ENABLED=false
# Set to 0 to stop Claude from posting the morning digest.
MCP_DIGEST_ENABLED=

# Set to 1 to turn off the 2 hour background bank sync, or the notification scheduler.
DISABLE_SYNC_TIMER=
DISABLE_SCHEDULER=

# ---------- Secrets (leave empty unless you manage them yourself) ----------
# TOKEN_ENC_KEY encrypts your bank access token (32 bytes base64). Losing it means reconnecting the bank.
TOKEN_ENC_KEY=
SYNC_SECRET=
MCP_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Local dev only: where the database lives. Docker and Fly set this for you.
# DATABASE_PATH=./data/ownbank.db
